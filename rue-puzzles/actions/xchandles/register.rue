// register.rue by yakuhito
// Responsible for registering new handles into the handle registry (XCHandles)

// Unlike CATalog, a slot's value is (c (c handle_hash (c left right)) (c expiration (c owner resolved))) where:
//  value is the slot 'key'/id and is defined as (sha256 1 handle) / (sha256tree handle)
//  left_value/right_value are the keys of the slot's neighbors
//  expiration is a timestamp that says when the handle will expire
//  owner is a 32-byte launcher id that specifies the owner of the record, who can
//       update the owner (i.e., transfer the handle) and resolved
//  resolved is a 32-byte launcher id that points to the singleton containing the resolved data
//       for XCHandles, for example. resolved may be a 32-byte launcher id of a name NFT
//       in the future, resolved might point to a namespace/sub-registry, for example

// Also note that anyone can extend a handle registration, but only the owner can transfer the
//   record or change the resolved_data

// Warning: Pricing puzzle is responsible for ensuring registered_time > 0

import xchandles::*;
import super::super::common_types::*;
import super::super::slot::*;

export fn main(
    SINGLETON_MOD_HASH: Bytes32,
    SINGLETON_LAUNCHER_PUZZLE_HASH: Bytes32,
    PRECOMMIT_1ST_CURRY_HASH: Bytes32, // after 1st curry
    HANDLE_SLOT_1ST_CURRY_HASH: Bytes32, // after 1st curry
    handle_hash: Bytes32,
    neighbors: HandleSlotNeighbors,
    cat_maker_puzzle_and_solution: PuzzleAndSolution,
    pricing_puzzle_and_solution: PuzzleAndSolution,
    {
        this_this_value: left_left_value,
        this_expiration: left_expiration,
        this_data: left_data,
    }: RegisterThisSlotInfo,
    {
        this_this_value: right_right_value,
        this_expiration: right_expiration,
        this_data: right_data,
    }: RegisterThisSlotInfo,
    {
        puzzle_hash_one: owner_inner_puzzle_hash,
        puzzle_hash_two: resolved_launcher_id,
    }: PuzzleHashes,
    ...other_precommit_data: OtherPrecommitData,
) -> (XchandlesStateTruth, List<Condition>) {
    inline let {
        puzzle_hash: precommited_pricing_puzzle_reveal_hash,
        puzzle: precommited_pricing_puzzle_reveal,
        solution: precommited_pricing_puzzle_solution,
    } = precommited_pricing_puzzle_and_solution;
    inline let {
        puzzle_hash: precommitted_cat_maker_reveal_hash,
        puzzle: precommitted_cat_maker_reveal,
        solution: precommitted_cat_maker_solution,
    } = precommitted_cat_maker_and_solution;

    inline let (
        _buy_time, (_current_expiration, (precommitted_handle, _rest))
    ) = unchecked_cast::<(Int, (Int, (String, Any)))>(precommited_pricing_puzzle_solution);
    let (total_price, _registered_time) =
            unchecked_cast::<fn(...sol: Any) -> (Int, Int)>(
                precommited_pricing_puzzle_reveal
            )(...precommited_pricing_puzzle_solution);

    let correct_slot = if slot_value is nil {
        true
    } else {
        sha256(0x01 + handle) == slot_value.a.handle_hash
    };

    if precommitted_cat_maker_reveal_hash == tree_hash(precommitted_cat_maker_reveal) &&
     precommited_pricing_puzzle_reveal_hash == tree_hash(precommited_pricing_puzzle_reveal) &&
     correct_slot {
        let precommit_coin_inner_puzzle_hash = curry_tree_hash(PRECOMMIT_1ST_CURRY_HASH, [
            other_precommit_data.refund_and_secret.refund_puzzle_hash_hash,
            sha256(0x01 + tree_hash(PrecommitValue {
                a: PrecommitValueA {
                    cat_maker_details: PuzzleDetails {
                        puzzle_hash: precommitted_cat_maker_reveal_hash,
                        puzzle_solution: precommitted_cat_maker_solution,
                    },
                    pricing_puzzle_details: PuzzleDetails {
                        puzzle_hash: precommited_pricing_puzzle_reveal_hash,
                        puzzle_solution: precommited_pricing_puzzle_solution,
                    },
                },
                b: PrecommitValueB {
                    handle_and_secret: PrecommitHandleAndSecret {
                        handle: handle,
                        secret: other_precommit_data.refund_and_secret.secret,
                    },
                    data: other_precommit_data.new_rest,
                },
            }))
        ]);
        let precommit_coin_full_puzzle_hash =
            unchecked_cast::<fn(inner_ph: Bytes32, ...sol: Any) -> Bytes32>(
                precommitted_cat_maker_reveal
            )(precommit_coin_inner_puzzle_hash, ...precommitted_cat_maker_solution);

        let last_conds = if
            // not (a)
            Truth.State.Cat_Maker_Puzzle_Hash == precommitted_cat_maker_reveal_hash &&
            // not (c)
            handle == precommitted_handle &&
            (
                precommited_pricing_puzzle_reveal_hash == Truth.State.Pricing_Puzzle_Hash ||
                precommited_pricing_puzzle_reveal_hash == Truth.State.Expired_Handle_Pricing_Puzzle_Hash
            ) &&
            // not (b)
            precommit_amount == total_price
        {
            // if the precommit coin looks valid after checking (a), (b), (c) & it could be used for registration,
            // we must check for (d)
            inline let slot_value = unchecked_cast::<XchandlesHandleSlotValue>(slot_value);
            let slot_value_hash = tree_hash(slot_value);
            [
                AssertBeforeSecondsAbsolute {
                    seconds: slot_value.b.expiration,
                },
                spend_slot(
                    HANDLE_SLOT_1ST_CURRY_HASH,
                    slot_value_hash,
                ),
                create_slot(
                    HANDLE_SLOT_1ST_CURRY_HASH,
                    slot_value_hash,
                ),
            ]
        } else {
            []
        };

        (Truth, [
            // consume precommit coin
            SendMessage {
                mode: 19, // sender puzzle + receiver puzzle + receiver amount
                message: nil, // 0 = refund
                receiver: [
                    precommit_coin_full_puzzle_hash,
                    precommit_amount,
                ]
            },
            // announcement
            CreatePuzzleAnnouncement {
                message: "$" + precommit_coin_full_puzzle_hash,
            },
            ...last_conds
        ])
     } else {
        raise "Invalid puzzle reveal hashes or provided slot is incorrect";
     }
}