// shared.rue by yakuhito
// Shared code for CATalog actions.

export struct CatalogState {
    Cat_Maker_Puzzle_Hash: Bytes32,
    ...Registration_Price: Int,
}

export struct CatalogStateTruth {
    Ephemeral_State: Any,
    ...State: CatalogState,
}

export struct PuzzleAndSolutionWithHash {
    puzzle_hash: Bytes32,
    puzzle: Any,
    ...solution: Any,
}

export struct PuzzleAndSolution {
    puzzle: Any,
    ...solution: Any,
}


export struct OtherPrecommitData {
    tail_hash: Bytes32,
    initial_nft_owner_ph: Bytes32,
    ...refund_puzzle_hash_hash: Bytes32,
}

export fn spend_slot(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
) -> Condition {
    SendMessage {
        mode: 18, // puzzle-puzzle
        message: nil, // ()
        receiver: [
            curry_tree_hash(SLOT_1ST_CURRY_HASH, [
                    sha256(0x01 + slot_value_hash)
                ]
            )
        ]
    }
}

export fn create_slot(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
) -> Condition {
    CreateCoin {
        puzzle_hash: curry_tree_hash(SLOT_1ST_CURRY_HASH, [
                sha256(0x01 + slot_value_hash)
            ]
        ),
        amount: 0,
        memos: Memos {
            value: [SLOT_1ST_CURRY_HASH],
        }
    }
}

export fn create_slot_with_hint(
    SLOT_1ST_CURRY_HASH: Bytes32,
    slot_value_hash: Bytes32,
    hint: Bytes32,
) -> Condition {
    CreateCoin {
        puzzle_hash: curry_tree_hash(SLOT_1ST_CURRY_HASH, [
                sha256(0x01 + slot_value_hash)
            ]
        ),
        amount: 0,
        memos: Memos {
            value: [hint],
        }
    }
}