// common_types.clsp by yakuhito
// Contains structs of common types used in many puzzles

export struct CompactCoinProof {
    parent_info: Bytes32,
    inner_puzzle_hash: Bytes32,
    ...amount: Int,
}

export struct PuzzleAndSolutionWithHash {
    puzzle_hash: Bytes32,
    puzzle: Any,
    ...solution: Any,
}

export struct PuzzleAndSolution {
    puzzle: Any,
    ...solution: Any,
}